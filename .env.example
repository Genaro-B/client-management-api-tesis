# Configuración general
# Copiá este archivo a .env y ajustá los valores según tu entorno.

# Base de datos
DATABASE_URL=sqlite:///./dev.db

# Seguridad
JWT_SECRET_KEY=tu-clave-secreta-super-segura-cambiala-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# Stock bajo (asistente administrativo y alertas)
LOW_STOCK_THRESHOLD=5

# Carga de imágenes
UPLOAD_DIR=backend/uploads
MAX_IMAGE_SIZE=2097152
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =========================================
# Asistente administrativo
# =========================================
# Selección de cerebro: classifier | deterministic | ollama
# - deterministic: SOLO matcher (idéntico a comportamiento original)
# - classifier: matcher primero -> clasificador local como fallback (default recomendado)
# - ollama: intenta Ollama; hace fallback si no responde/da error
ADMIN_BOT_BRAIN=classifier

# Umbral de confianza mínimo para el clasificador local (NLU)
ADMIN_BOT_NLU_THRESHOLD=0.55

# Ollama (opcional, deshabilitado por defecto)
# Solo se usa si ADMIN_BOT_BRAIN=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30